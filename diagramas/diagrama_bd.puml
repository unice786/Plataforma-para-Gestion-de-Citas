estes es el entidad de relacion


@startuml Diagrama_Entidad_Relacion

' Configuración visual básica
hide circle

skinparam linetype ortho

entity "usuarios" as usuario {
  * id : BIGINT <<PK>>
  --
  * nombre : VARCHAR(100)
  * correo : VARCHAR(150) <<UNIQUE>>
  * password : VARCHAR(255)
  * activo : BOOLEAN
}

entity "administradores" as administrador {
  * id : BIGINT <<PK, FK>>
}

entity "clientes" as cliente {
  * id : BIGINT <<PK, FK>>
  --
  * telefono : VARCHAR(20)
}

entity "empleados" as empleado {
  * id : BIGINT <<PK, FK>>
  --
  * especialidad_id : BIGINT <<FK>>
}

entity "especialidades" as especialidad {
  * id : BIGINT <<PK>>
  --
  * nombre : VARCHAR(100) <<UNIQUE>>
  descripcion : TEXT
}

entity "categorias_servicio" as categoria_servicio {
  * id : BIGINT <<PK>>
  --
  * nombre : VARCHAR(50) <<UNIQUE>>
  descripcion : TEXT
}

entity "servicios" as servicio {
  * id : BIGINT <<PK>>
  --
  * categoria_id : BIGINT <<FK>>
  * nombre : VARCHAR(100)
  descripcion : TEXT
  * precio : DECIMAL(10,2)
  * duracion_minutos : INT
  * activo : BOOLEAN
}

entity "empleado_servicio" as empleado_servicio {
  * empleado_id : BIGINT <<PK, FK>>
  * servicio_id : BIGINT <<PK, FK>>
}

entity "horarios_disponibilidad" as horario_disponibilidad {
  * id : BIGINT <<PK>>
  --
  * empleado_id : BIGINT <<FK>>
  * fecha : DATE
  * hora_inicio : TIME
  * hora_fin : TIME
  * estado : VARCHAR(20)
}

entity "citas" as cita {
  * id : BIGINT <<PK>>
  --
  * cliente_id : BIGINT <<FK>>
  * empleado_id : BIGINT <<FK>>
  * servicio_id : BIGINT <<FK>>
  * fecha : DATE
  * hora : TIME
  * estado : VARCHAR(20)
  * fecha_registro : DATETIME
}

' Relaciones de Herencia (JOINED)
usuario ||--|| administrador : "es un"
usuario ||--|| cliente : "es un"
usuario ||--|| empleado : "es un"

' Otras relaciones
especialidad ||--o{ empleado
categoria_servicio ||--o{ servicio
empleado ||--o{ horario_disponibilidad

' Relación Muchos a Muchos
empleado ||--o{ empleado_servicio
servicio ||--o{ empleado_servicio

' Relaciones de Cita
cliente ||--o{ cita
empleado ||--o{ cita
servicio ||--o{ cita

@enduml
